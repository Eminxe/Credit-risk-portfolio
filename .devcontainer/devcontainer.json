{
  "name": "Plata Risk — Python 3.12",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "analytics",
  "workspaceFolder": "/workspace",
  "runServices": ["postgres", "analytics"],
  "overrideCommand": true,
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter", "openai.chatgpt"],
      "settings": {"python.defaultInterpreterPath": "/usr/local/bin/python"}
    }
  }
}
